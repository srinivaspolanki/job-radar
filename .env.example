# Job Radar — Environment Configuration Template
# Copy this file to .env to configure local Telegram notifications:
# cp .env.example .env

# 1. Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 2. Telegram Personal Chat ID (obtain by messaging @userinfobot on Telegram)
TELEGRAM_CHAT_ID="123456789"

# 3. Optional: Your live GitHub Pages dashboard URL
DASHBOARD_URL="https://your-username.github.io/job-radar"
